---
/**
 * Starlight's search, with something in the box before you type.
 *
 * The default modal opens empty: a cursor and a blank panel, which tells a
 * first-time reader nothing about what is in here. This wraps it and injects two
 * blocks into the dialog while the input is empty — six places worth starting,
 * and the terms people actually arrive searching for — then gets out of the way
 * the moment a character is typed. Pagefind is untouched; this is the empty
 * state it does not ship.
 *
 * Titles and section labels are read from the content collection and
 * `sidebar.js` at build time, so a renamed page cannot leave a stale suggestion
 * behind.
 */
import Default from '@astrojs/starlight/components/Search.astro';
import { getCollection } from 'astro:content';
import { sidebar } from '../sidebar.js';

/** Six entry points, chosen for "I do not know what is here yet". */
const SUGGESTED = [
  'tweaks',
  'reference/debunked',
  'guides/benchmark/dpc-latency',
  'guides/security',
  'reference/service-reference',
  'reference/undoing-a-tweak',
];

/** Terms that land on a specific answer rather than a category. */
const QUERIES = ['HPET', 'MSI mode', 'Win32PrioritySeparation', 'VBS', 'core parking', 'TSME'];

const docs = await getCollection('docs');
const norm = (value: string) =>
  value.replace(/^\/+|\/+$/g, '').replace(/(^|\/)index$/, '$1').replace(/\/$/, '');
const byId = new Map(docs.map((entry) => [norm(entry.id), entry]));

/** The sidebar group a slug sits in, used as the result's category chip. */
function sectionOf(slug: string): string {
  const target = norm(slug);
  const walk = (items: any[], label: string): string | null => {
    for (const item of items) {
      if (item.items) {
        const found = walk(item.items, item.label ?? label);
        if (found) return found;
      } else if (item.autogenerate) {
        // An autogenerated group owns everything under its directory.
        const dir = norm(item.autogenerate.directory);
        if (target === dir || target.startsWith(`${dir}/`)) return label;
      } else if (item.slug && norm(item.slug) === target) {
        return label;
      }
    }
    return null;
  };
  for (const group of sidebar) {
    const found = walk(group.items, group.label);
    if (found) return found;
  }
  return '';
}

const suggestions = SUGGESTED.map((slug) => {
  const entry = byId.get(norm(slug));
  const items = sidebar.flatMap((group) => group.items);
  return {
    label: items.find((item: any) => item.slug && norm(item.slug) === norm(slug))?.label
      ?? entry?.data.title
      ?? slug,
    section: sectionOf(slug),
    href: `${import.meta.env.BASE_URL}/${norm(slug)}/`.replace(/\/{2,}/g, '/'),
  };
});
---

<Default {...Astro.props} />

<template id="tc-search-empty">
  <div class="tc-search-empty">
    <p class="tc-search-label">Start somewhere</p>
    <ul class="tc-search-links">
      {
        suggestions.map((item) => (
          <li>
            <a href={item.href}>
              <span class="tc-search-title">{item.label}</span>
              {item.section && item.section !== item.label && (
                <span class="tc-search-chip">{item.section}</span>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <p class="tc-search-label">Common searches</p>
    <div class="tc-search-queries">
      {QUERIES.map((query) => <button type="button" data-query={query}>{query}</button>)}
    </div>

    {/* Pagefind's UI has no arrow-key result navigation — tab is what moves,
        checked in a browser rather than assumed. */}
    <div class="tc-search-keys">
      <span><kbd>tab</kbd> to move</span>
      <span><kbd>↵</kbd> to open</span>
      <span><kbd>esc</kbd> to close</span>
    </div>
  </div>
</template>

<script>
  const template = document.querySelector<HTMLTemplateElement>('#tc-search-empty');
  const search = document.querySelector('site-search');
  const frame = search?.querySelector('.dialog-frame');
  const dialog = search?.querySelector('dialog');

  if (template && frame && dialog) {
    const panel = template.content.firstElementChild!.cloneNode(true) as HTMLElement;
    frame.append(panel);

    /** The panel is the empty state, so it is only ever up while the box is. */
    let input: HTMLInputElement | null = null;
    const sync = () => {
      panel.hidden = Boolean(input && input.value.trim());
    };

    // Pagefind mounts on idle, well after this runs, so wait for its input
    // rather than racing it.
    const attach = () => {
      input = frame.querySelector<HTMLInputElement>('input.pagefind-ui__search-input');
      if (!input) return false;
      input.addEventListener('input', sync);
      sync();
      return true;
    };

    if (!attach()) {
      const observer = new MutationObserver(() => {
        if (attach()) observer.disconnect();
      });
      observer.observe(frame, { childList: true, subtree: true });
    }

    dialog.addEventListener('close', sync);

    // A term chip runs the search rather than navigating: the reader wanted the
    // results page, not one of the six pages above it.
    panel.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-query]');
      if (!button || !input) return;
      input.value = button.dataset.query ?? '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.focus();
      sync();
    });
  }
</script>

<style is:global>
  .tc-search-empty {
    padding-top: 0.25rem;
  }

  .tc-search-empty[hidden] {
    display: none;
  }

  .tc-search-label {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .tc-search-links {
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1px;
  }

  .tc-search-links a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-1);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .tc-search-links a:hover,
  .tc-search-links a:focus-visible {
    border-color: var(--tc-purple);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    outline: none;
  }

  .tc-search-title {
    font-weight: 600;
  }

  /* The section the page sits in, so a result is placed without opening it. */
  .tc-search-chip {
    margin-inline-start: auto;
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--tc-border);
    border-radius: 999px;
    font-size: 0.65rem;
    letter-spacing: 0.02em;
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }

  .tc-search-queries {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .tc-search-queries button {
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--tc-border);
    border-radius: 999px;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .tc-search-queries button:hover {
    border-color: var(--tc-purple);
    color: var(--sl-color-white);
  }

  .tc-search-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--tc-border-soft);
    font-size: 0.7rem;
    color: var(--sl-color-gray-4);
  }

  .tc-search-keys kbd {
    display: inline-block;
    min-width: 1.1rem;
    margin-inline-end: 0.15rem;
    padding: 0.05rem 0.25rem;
    border: 1px solid var(--tc-border);
    border-radius: 0.25rem;
    background: var(--sl-color-gray-6);
    font-family: var(--sl-font-mono);
    font-size: 0.65rem;
    text-align: center;
  }

  /* The dialog itself: the site's border and glow rather than Starlight's grey
     box, and a ceiling low enough that the suggestions do not sit in the middle
     of an otherwise empty sheet. */
  site-search dialog {
    border: 1px solid var(--tc-border);
    border-radius: 0.75rem;
    background-color: var(--tc-surface);
    box-shadow: var(--tc-glow);
  }

  @media (min-width: 50rem) {
    site-search dialog {
      min-height: 0;
    }
  }
</style>
