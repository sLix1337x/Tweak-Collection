---
/**
 * Every page in the collection, grouped the way the sidebar groups them.
 *
 * The tree comes from `src/sidebar.js` and the one-line summaries come from each
 * page's own `description`, both read at build time. Nothing is listed here by
 * hand, because a second list is a list that goes stale — the same reason
 * `TweakIndex.astro` reads the tweak rows out of the pages.
 */
import { getCollection } from 'astro:content';
import { sidebar } from '../sidebar.js';

const docs = await getCollection('docs');

/** `guides/bios/index` and `/guides/bios/` both key as `guides/bios`. */
const norm = (value: string) =>
  value.replace(/^\/+|\/+$/g, '').replace(/(^|\/)index$/, '$1').replace(/\/$/, '');

const byId = new Map(docs.map((entry) => [norm(entry.id), entry]));
const order = (entry?: (typeof docs)[number]) => Number(entry?.data.sidebar?.order ?? 99);

type Link = { label: string; href: string; description: string };
type Row = Link | { group: string; links: Link[] };

function toLink(slug: string, label?: string): Link {
  const entry = byId.get(norm(slug));
  return {
    label: label ?? entry?.data.title ?? slug,
    href: `${import.meta.env.BASE_URL}/${norm(slug)}/`.replace(/\/{2,}/g, '/'),
    description: entry?.data.description ?? '',
  };
}

function expand(item: any): Row[] {
  // An autogenerated group: everything under the directory, in sidebar order.
  if (item.autogenerate) {
    const dir = norm(item.autogenerate.directory);
    return docs
      .filter((entry) => {
        const id = norm(entry.id);
        return id === dir || id.startsWith(`${dir}/`);
      })
      .sort((a, b) => order(a) - order(b) || a.data.title.localeCompare(b.data.title))
      .map((entry) => toLink(entry.id));
  }
  // A nested group, as the two sockets are under BIOS.
  if (item.items) {
    return [{ group: item.label, links: item.items.flatMap(expand) as Link[] }];
  }
  return [toLink(item.slug, item.label)];
}

const groups = sidebar.map((group) => ({
  label: group.label,
  rows: group.items.flatMap(expand),
}));

const pages = new Set(
  groups.flatMap(({ rows }) =>
    rows.flatMap((row) => ('group' in row ? row.links : [row])).map((link) => link.href),
  ),
).size;
---

<div class="tc-siteindex not-content">
  <p class="tc-siteindex-count">{pages} pages across {groups.length} sections</p>

  {
    groups.map((group) => (
      <section class="tc-siteindex-group">
        <h3>{group.label}</h3>
        <ul>
          {group.rows.map((row) =>
            'group' in row ? (
              <li class="tc-siteindex-nested">
                <b>{row.group}</b>
                <ul>
                  {row.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                      <span>{link.description}</span>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={row.href}>{row.label}</a>
                <span>{row.description}</span>
              </li>
            ),
          )}
        </ul>
      </section>
    ))
  }
</div>
